### Login
< {%
    // Wipe any leftover state from previous runs before logging in
    client.global.clearAll();
%}

POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

> {%
    client.test("Login successful", function () {
        client.assert(response.status === 200, "Response status is not 200");
        client.assert(response.body.data.token !== undefined, "Token was not returned");
    });

    client.global.set("jwt", response.body.data.token);
    client.global.set("userId", response.body.data.user.id);
%}